# ==============================================================================
# STRATA: .gitignore
# ==============================================================================

# Node & Next.js
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment Variables & Local Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Temporary Diagnostics & Scratch Work
scratch/
diff.txt
*.log

# Unused Large Media Assets (>50MB unused)
frontend/public/evidence/snapshots/